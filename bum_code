from pygame import *
from random import*
from time import time as timer
clock= time.Clock()
win_width=600
win_height=300
back = (0,100,0)

game = True
finish = False

window=display.set_mode((win_width, win_height))
display.set_caption('пинг понг')
window.fill(back)

class GameSprite(sprite.Sprite):
    def __init__(self, q_image, x, y, speed, size_x, size_y):
        super().__init__()
        self.image = transform.scale(image.load(q_image), (size_x, size_y))
        self.speed = speed
        self.rect = self.image.get_rect()
        self.rect.x = x
        self.rect.y = y
        self.size_x = size_x
        self.size_y = size_y
    def reset(self):
        window.blit(self.image, (self.rect.x, self.rect.y))

class Player(GameSprite):
    def update_l(self):
        keys = key.get_pressed()
        if keys[K_w] and self.rect.y > 5:
            self.rect.x -= self.speed
        if keys[K_s] and self.rect.y < win_height - 40:
            self.rect.x += self.speed

    def update_r(self):
        keys = key.get_pressed()
        if keys[K_UP] and self.rect.y > 5:
            self.rect.x -= self.speed
        if keys[K_DOWN] and self.rect.y < win_height - 80:
            self.rect.x += self.speed


    def fire(self):
        bullet = Bullet('bullet.png', self.rect.centerx - 10, self.rect.top, 5, 20, 20)
        bullets.add(bullet)

pong= Player('pong.png',10,300,10,30,80)
ping= Player('pong.png',10,300,10,30,80)


while game == True:
    for e in event.get():
        if e.type == QUIT:
            game = False
    if finish == False:
        pong(reset)
        pong(update_l)
        ping(reset)
        ping(update_r)
    display.update()
    clock.tick(60)
